# StrakWerk HQ — omgevingsvariabelen. GEEN echte waarden in dit bestand of in Git.
# Productie: Vercel › Project › Settings › Environment Variables.
# Lokaal: kopieer naar .env.local (staat in .gitignore) en start met `npm run dev`.

# ── Verplicht ────────────────────────────────────────────────────────────
# Supabase Postgres via de transaction pooler (poort 6543). Vorm:
# postgres://postgres.PROJECT-REF:WACHTWOORD@HOST:6543/postgres
# (HOST staat in Supabase › Connect › Transaction pooler, bijv. een *.pooler.supabase.com-adres)
DATABASE_URL=
# Optioneel: CA-certificaat van Supabase (Database settings › SSL) voor volledige certificaatcontrole.
DATABASE_CA_CERT=

SUPABASE_URL=https://<project-ref>.supabase.co
# Publieke sleutel (mag in de browser): "publishable key" of de oudere "anon key".
SUPABASE_PUBLISHABLE_KEY=
# Alleen server: nodig om uit te nodigen en accounts te blokkeren. Nooit in de browser.
SUPABASE_SECRET_KEY=
# Alleen nodig bij oudere projecten met een HS256 JWT-secret. Leeg = JWKS van Supabase.
SUPABASE_JWT_SECRET=

HQ_SITE_URL=https://www.strakwerkk.nl
# Lang willekeurig geheim; Vercel Cron stuurt het mee naar /api/worker.
CRON_SECRET=

# ── Optioneel ────────────────────────────────────────────────────────────
# Rollen waarvoor tweestapsverificatie verplicht is (komma-gescheiden).
HQ_MFA_ROLES=eigenaar
# Hosts die als productieverkeer tellen.
HQ_PRODUCTION_HOSTS=www.strakwerkk.nl,strakwerkk.nl

# Claude voor Scout/Auditor/Sales. Zonder sleutel: alleen metingen en sjabloonconcepten.
ANTHROPIC_API_KEY=
HQ_LLM_MODEL=claude-opus-5-5

# Google PageSpeed Insights (werkt ook zonder sleutel, met een lage limiet). "uit" = overslaan.
PAGESPEED_API_KEY=
HQ_PAGESPEED=

# Vercel Web Analytics API (officieel, alleen lezen). Token: vercel.com › Account › Tokens.
VERCEL_ANALYTICS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
