{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "strakwerkk.nl"
        }
      ],
      "destination": "https://www.strakwerkk.nl/:path*",
      "permanent": true
    },
    {
      "source": "/service-starter",
      "destination": "/prijzen",
      "permanent": true
    },
    {
      "source": "/service-pro",
      "destination": "/prijzen",
      "permanent": true
    },
    {
      "source": "/service-onderhoud",
      "destination": "/prijzen",
      "permanent": true
    },
    {
      "source": "/service-ecom",
      "destination": "/diensten/webshop-laten-maken",
      "permanent": true
    },
    {
      "source": "/service-boost",
      "destination": "/diensten",
      "permanent": true
    },
    {
      "source": "/diensten/website-laten-maken-zoetermeer",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/diensten/website-laten-maken-delft",
      "destination": "/diensten/website-laten-maken",
      "permanent": true
    },
    {
      "source": "/diensten/website-laten-maken-westland",
      "destination": "/diensten/website-laten-maken",
      "permanent": true
    }
  ]
}
